{
  // Type-checking only. Vite (esbuild) strips the types and does the actual build, so tsc
  // never emits anything; `npm run build` runs it first so a type error fails the build.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "isolatedModules": true,
    // scripts/check-smoothing.mjs imports useSmoothedText.ts under Node's type stripping,
    // which only handles syntax it can erase (no enums, no parameter properties).
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
